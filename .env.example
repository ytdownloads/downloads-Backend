# ==============================================================================
# YTdownloader Backend — Environment Variables Template
# ==============================================================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (supports comma-separated origins, or * for open CORS)
# In production, set this to your deployed frontend domain(s):
# Example: FRONTEND_URL=https://youtubedownloader-maker.github.io,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Download Concurrency (Maximum simultaneous active yt-dlp workers)
DOWNLOAD_CONCURRENCY=2

# Playlist Limits
MAX_PLAYLIST_ITEMS=100

# Execution Timeouts (in milliseconds)
DOWNLOAD_TIMEOUT_MS=600000
FFMPEG_TIMEOUT_MS=1800000
INFO_TIMEOUT_MS=60000

# Temporary File Storage & Retention
JOB_CLEANUP_DELAY_MS=300000
TEMP_DIR=./temp_downloads

# Rate Limiting (max requests per 15-minute window per IP, /health is exempted)
RATE_LIMIT_MAX=500
